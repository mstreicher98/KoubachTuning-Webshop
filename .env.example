# Für die lokale Entwicklung optional: nach .env kopieren (cp .env.example .env)

# Öffentliche Adressen (Links in E-Mails, Zahlungs-Rücksprünge). Lokal nicht nötig.
# SHOP_URL=https://koubach.astronox.dev
# ADMIN_URL=https://koubachadmin.astronox.dev

# Schlüssel für die gespeicherten Zugangsdaten (Stripe, PayPal, SMTP).
# Leer = zufälliger Schlüssel in data/.schluessel
# APP_SECRET=

# Erster Admin-Zugang – wird nur beim allerersten Start angelegt
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_EMAIL=office@astronox.dev
# INITIAL_ADMIN_PASSWORD=
